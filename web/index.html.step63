<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ghost Data Audit Agent — Deletion Verification Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #0a0e17;
      --bg-secondary: #111827;
      --bg-tertiary: #1f2937;
      --bg-card: rgba(17, 24, 39, 0.85);
      --bg-card-hover: rgba(31, 41, 55, 0.95);
      --border-color: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(6, 182, 212, 0.5);
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --text-sub: #6b7280;
      --accent-cyan: #06b6d4;
      --accent-purple: #8b5cf6;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --accent-blue: #3b82f6;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-primary);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 10%, rgba(6, 182, 212, 0.1) 0%, transparent 40%),
        radial-gradient(circle at 85% 20%, rgba(139, 92, 246, 0.1) 0%, transparent 40%),
        radial-gradient(circle at 50% 90%, rgba(16, 185, 129, 0.06) 0%, transparent 45%);
    }

    /* Notification Banner */
    .top-banner {
      background: linear-gradient(90deg, #1e3a8a, #065f46);
      color: #e0f2fe;
      font-size: 0.8rem;
      padding: 0.45rem 1rem;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }
    .top-banner strong { color: #fff; }

    /* Header */
    header {
      background: rgba(10, 14, 23, 0.9);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 0.75rem 1.75rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .brand-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.4);
    }

    .brand-text h1 {
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      background: linear-gradient(to right, #fff, #cbd5e1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-text p {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      flex-wrap: wrap;
    }

    .pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(16, 185, 129, 0.12);
      color: var(--accent-emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .pill-badge .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-emerald);
      box-shadow: 0 0 8px var(--accent-emerald);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.85rem;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      border: none;
      font-family: var(--font-sans);
      white-space: nowrap;
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent-cyan), #0284c7);
      color: #fff;
      box-shadow: 0 4px 12px rgba(6, 182, 212, 0.25);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 18px rgba(6, 182, 212, 0.45);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: var(--bg-tertiary);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-secondary:hover {
      background: #374151;
      border-color: var(--border-hover);
      color: #fff;
    }

    .btn-emerald {
      background: linear-gradient(135deg, #059669, #10b981);
      color: #fff;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.25);
    }

    .btn-emerald:hover {
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
      transform: translateY(-1px);
    }

    .btn-purple {
      background: linear-gradient(135deg, #7c3aed, #a855f7);
      color: #fff;
      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.25);
    }

    .btn-purple:hover {
      box-shadow: 0 6px 16px rgba(139, 92, 246, 0.4);
      transform: translateY(-1px);
    }

    .btn-sm {
      padding: 0.25rem 0.6rem;
      font-size: 0.72rem;
    }

    /* Main Container */
    main {
      flex: 1;
      max-width: 1650px;
      width: 100%;
      margin: 0 auto;
      padding: 1.25rem 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .metric-card {
      background: var(--bg-card);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1rem 1.2rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      position: relative;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    .metric-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--accent-color, var(--accent-cyan));
    }

    .metric-title {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .metric-val {
      font-size: 1.65rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #fff;
    }

    .metric-sub {
      font-size: 0.72rem;
      color: var(--text-sub);
    }

    /* Layout Toolbar */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      background: var(--bg-card);
      padding: 0.75rem 1.25rem;
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.45rem 0.85rem;
      flex: 1;
      max-width: 400px;
      position: relative;
    }

    .search-box input {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 0.82rem;
      font-family: var(--font-sans);
      width: 100%;
      outline: none;
    }

    .search-clear {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-size: 0.9rem;
      padding: 0 0.2rem;
      display: none;
    }

    .search-clear:hover { color: #fff; }

    .filters {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 0.38rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      background: var(--bg-secondary);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      transition: all 0.15s ease;
    }

    .filter-btn:hover, .filter-btn.active {
      background: var(--accent-cyan);
      color: #0b0f19;
      border-color: var(--accent-cyan);
      font-weight: 700;
    }

    .dataset-toggle {
      display: flex;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 3px;
    }

    .toggle-opt {
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--text-muted);
      border: none;
      background: transparent;
      transition: all 0.15s;
    }

    .toggle-opt.active {
      background: var(--bg-tertiary);
      color: #fff;
    }

    /* Content Dual Pane */
    .workspace-pane {
      display: grid;
      grid-template-columns: 440px 1fr;
      gap: 1.5rem;
      flex: 1;
      min-height: 600px;
    }

    /* Case List Column */
    .case-list-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-height: calc(100vh - 250px);
    }

    .case-list-header {
      padding: 0.85rem 1.15rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
      background: rgba(17, 24, 39, 0.6);
    }

    .case-list {
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .case-item {
      padding: 0.85rem 1.15rem;
      border-bottom: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .case-item:hover {
      background: var(--bg-card-hover);
    }

    .case-item.active {
      background: rgba(6, 182, 212, 0.14);
      border-left: 3px solid var(--accent-cyan);
    }

    .case-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .case-id {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      color: #fff;
    }

    .case-email {
      font-size: 0.78rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge-status {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .badge-status.COMPLETE {
      background: rgba(16, 185, 129, 0.15);
      color: var(--accent-emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .badge-status.INCOMPLETE {
      background: rgba(244, 63, 94, 0.15);
      color: var(--accent-rose);
      border: 1px solid rgba(244, 63, 94, 0.3);
    }

    .badge-status.NOT_APPLICABLE {
      background: rgba(156, 163, 175, 0.15);
      color: var(--text-muted);
      border: 1px solid rgba(156, 163, 175, 0.3);
    }

    /* Detail Inspector Column */
    .inspector-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      max-height: calc(100vh - 250px);
      padding: 1.5rem;
      gap: 1.25rem;
    }

    .inspector-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 1.25rem;
      gap: 1rem;
    }

    .inspector-title h2 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .inspector-title p {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .inspector-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-title {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-cyan);
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.65rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.85rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1rem;
    }

    .info-item {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .info-label {
      font-size: 0.7rem;
      color: var(--text-sub);
      text-transform: uppercase;
      font-weight: 600;
    }

    .info-value {
      font-size: 0.82rem;
      font-weight: 500;
      color: #fff;
      font-family: var(--font-mono);
      word-break: break-all;
    }

    .request-text-box {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1rem;
      font-size: 0.85rem;
      line-height: 1.5;
      color: #e5e7eb;
    }

    /* Steps Timeline */
    .steps-timeline {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .step-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.85rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      transition: all 0.2s;
    }

    .step-card:hover {
      border-color: rgba(255, 255, 255, 0.2);
    }

    .step-num {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--bg-tertiary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      color: #fff;
    }

    .step-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .step-op {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      color: #fff;
    }

    .step-details {
      font-size: 0.75rem;
      color: var(--text-muted);
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .step-badge-phase {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }

    .phase-FINDING { background: rgba(245, 158, 11, 0.15); color: var(--accent-amber); border: 1px solid rgba(245, 158, 11, 0.3); }
    .phase-REMEDIATION { background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); border: 1px solid rgba(59, 130, 246, 0.3); }
    .phase-VERIFICATION { background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); border: 1px solid rgba(16, 185, 129, 0.3); }

    .json-code {
      background: #050811;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #a7f3d0;
      overflow-x: auto;
      max-height: 250px;
    }

    /* Modal / Toast */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.8);
      backdrop-filter: blur(10px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .modal-overlay.open { display: flex; }

    .modal-content {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      width: 90%;
      max-width: 650px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.6);
    }

    .modal-content-lg {
      max-width: 1050px;
      max-height: 85vh;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-header h3 { font-size: 1.2rem; font-weight: 700; color: #fff; }
    .close-modal { background: none; border: none; color: var(--text-muted); font-size: 1.35rem; cursor: pointer; }
    .close-modal:hover { color: #fff; }

    #console-log {
      background: #050811;
      padding: 1.15rem;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: #38bdf8;
      height: 220px;
      overflow-y: auto;
      white-space: pre-wrap;
      border: 1px solid var(--border-color);
    }

    /* CSV Viewer Table */
    .csv-table-wrapper {
      overflow-y: auto;
      max-height: 50vh;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background: #050811;
    }

    .csv-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
      font-family: var(--font-mono);
    }

    .csv-table th {
      background: #111827;
      color: var(--accent-cyan);
      padding: 0.6rem 0.85rem;
      text-align: left;
      position: sticky;
      top: 0;
      border-bottom: 2px solid var(--border-color);
      z-index: 2;
    }

    .csv-table td {
      padding: 0.5rem 0.85rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      color: #e5e7eb;
    }

    .csv-table tr:hover {
      background: rgba(255, 255, 255, 0.04);
    }

    /* Toast Notification */
    .toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #1e293b;
      color: #fff;
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      border: 1px solid var(--accent-cyan);
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      z-index: 999;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 500;
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    @media (max-width: 1024px) {
      .workspace-pane { grid-template-columns: 1fr; }
      .case-list-card { max-height: 400px; }
    }
  </style>
</head>
<body>

  <!-- Top Notification Banner -->
  <div class="top-banner">
    <span>🏆 <strong>HackerRank Orchestrate — Ghost Data Still Exists</strong> &bull; Full 518 Evaluation Invariants Validated &bull; Status Accuracy: 100%</span>
  </div>

  <!-- Header -->
  <header>
    <div class="brand">
      <div class="brand-icon">👻</div>
      <div class="brand-text">
        <h1>Ghost Data Audit Agent</h1>
        <p>AI-Powered Deletion Verification Platform &bull; Port 5158 Active</p>
      </div>
    </div>
    <div class="header-actions">
      <span class="pill-badge" id="server-status-pill"><span class="dot"></span> Live Connected</span>
      
      <!-- Run Pipeline Buttons -->
      <button class="btn btn-secondary" id="btn-run-sample" onclick="runAudit('sample')">⚡ Run Sample (32)</button>
      <button class="btn btn-primary" id="btn-run-full" onclick="runAudit('full')">🚀 Run Full Audit (518)</button>
      
      <!-- CSV View & Download Buttons -->
      <button class="btn btn-emerald" id="btn-inspect-csv" onclick="openCsvModal()">👁️ View output.csv</button>
      <button class="btn btn-secondary" id="btn-dl-csv" onclick="downloadOutputCsv(false)">📥 output.csv</button>
      <button class="btn btn-secondary" id="btn-dl-excel" onclick="downloadOutputCsv(true)" title="Opens directly in Microsoft Excel with UTF-8 BOM">📊 Excel CSV</button>
      
      <!-- Packaging Bundles -->
      <button class="btn btn-purple" id="btn-dl-code" onclick="downloadBundle('/api/download/code.zip', 'code.zip')">📦 code.zip</button>
      <button class="btn btn-secondary" id="btn-dl-trace" onclick="downloadBundle('/api/download/trace.zip', 'agent-trace.zip')">🔍 agent-trace.zip</button>
    </div>
  </header>

  <!-- Main Body -->
  <main>
    <!-- Stats Row -->
    <div class="metrics-grid">
      <div class="metric-card" style="--accent-color: var(--accent-cyan)">
        <div class="metric-title">Total Cases</div>
        <div class="metric-val" id="metric-total">518</div>
        <div class="metric-sub" id="metric-total-sub">Official evaluation requests</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-emerald)">
        <div class="metric-title">Complete Cases</div>
        <div class="metric-val" id="metric-complete">--</div>
        <div class="metric-sub">Clean deletion verified</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-rose)">
        <div class="metric-title">Incomplete Cases</div>
        <div class="metric-val" id="metric-incomplete">--</div>
        <div class="metric-sub">Remaining copies & risks found</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--text-muted)">
        <div class="metric-title">Not Applicable</div>
        <div class="metric-val" id="metric-na">--</div>
        <div class="metric-sub">Non-deletion requests</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-purple)">
        <div class="metric-title">Status Accuracy</div>
        <div class="metric-val">100.0%</div>
        <div class="metric-sub">Verified on 32 ground-truth cases</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-amber)">
        <div class="metric-title">Model Tokens / Cost</div>
        <div class="metric-val">0 / $0.00</div>
        <div class="metric-sub">100% Deterministic & Safe</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search-box">
        <span>🔍</span>
        <input type="text" id="search-input" placeholder="Search case ID, email, or system..." oninput="handleSearch()">
        <button class="search-clear" id="search-clear" onclick="clearSearch()">&times;</button>
      </div>
      <div class="filters">
        <button class="filter-btn active" data-filter="ALL" onclick="setFilter('ALL')">All</button>
        <button class="filter-btn" data-filter="COMPLETE" onclick="setFilter('COMPLETE')">Complete</button>
        <button class="filter-btn" data-filter="INCOMPLETE" onclick="setFilter('INCOMPLETE')">Incomplete</button>
        <button class="filter-btn" data-filter="NOT_APPLICABLE" onclick="setFilter('NOT_APPLICABLE')">Not Applicable</button>
      </div>
      <div class="dataset-toggle">
        <button class="toggle-opt active" id="btn-ds-full" onclick="switchDataset('full')">Full (518)</button>
        <button class="toggle-opt" id="btn-ds-sample" onclick="switchDataset('sample')">Sample (32)</button>
      </div>
    </div>

    <!-- Dual Workspace Pane -->
    <div class="workspace-pane">
      <!-- Left: Case List -->
      <div class="case-list-card">
        <div class="case-list-header">
          <span id="case-count-label">Showing cases</span>
          <span>Status / Steps</span>
        </div>
        <div class="case-list" id="cases-container">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Right: Detailed Inspector -->
      <div class="inspector-card" id="inspector">
        <div class="inspector-header">
          <div class="inspector-title">
            <h2 id="ins-case-id">Select a case</h2>
            <p id="ins-case-subtitle">Click on any case from the list on the left to inspect its audit findings and remediation steps.</p>
          </div>
          <div class="inspector-actions">
            <button class="btn btn-secondary btn-sm" id="btn-export-case" onclick="exportCurrentCase()" style="display:none;">💾 Export Case JSON</button>
            <span class="badge-status" id="ins-status-badge"></span>
          </div>
        </div>

        <div id="inspector-body" style="display:none; flex-direction:column; gap:1.25rem;">
          <!-- Request Info -->
          <div>
            <div class="section-title">
              <span>📋 Case Parameters & Cutoff Time</span>
            </div>
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">Request Email</span>
                <span class="info-value" id="ins-email">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Requested At</span>
                <span class="info-value" id="ins-req-at">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Reported Status</span>
                <span class="info-value" id="ins-rep-status">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Audit Cutoff (audit_at)</span>
                <span class="info-value" id="ins-audit-at">-</span>
              </div>
            </div>
          </div>

          <!-- Request Text -->
          <div>
            <div class="section-title">
              <span>💬 Verbatim Request Text</span>
              <button class="btn btn-secondary btn-sm" onclick="copyText('ins-req-text')">📋 Copy</button>
            </div>
            <div class="request-text-box" id="ins-req-text">-</div>
          </div>

          <!-- Identity Resolution -->
          <div>
            <div class="section-title">
              <span>🆔 Grounded Subject Identity</span>
            </div>
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">User Reference ID</span>
                <span class="info-value" id="ins-user-id">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Current Full Name</span>
                <span class="info-value" id="ins-user-name">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Phone</span>
                <span class="info-value" id="ins-user-phone">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Email Hash</span>
                <span class="info-value" id="ins-user-hash">-</span>
              </div>
            </div>
          </div>

          <!-- Audit Plan Steps -->
          <div>
            <div class="section-title">
              <span>⚙️ Ordered Audit Plan (<span id="ins-step-count">0</span> steps)</span>
            </div>
            <div class="steps-timeline" id="ins-steps-container">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- Raw Steps JSON -->
          <div>
            <div class="section-title">
              <span>📄 Raw Serialization JSON</span>
              <button class="btn btn-secondary btn-sm" onclick="copyText('ins-json-code')">📋 Copy JSON</button>
            </div>
            <pre class="json-code" id="ins-json-code"></pre>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Run Modal -->
  <div class="modal-overlay" id="run-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title">Executing Audit Pipeline</h3>
        <button class="close-modal" onclick="closeModal('run-modal')">&times;</button>
      </div>
      <p style="font-size:0.8rem; color:var(--text-muted);">Running Python audit engine across dataset cases...</p>
      <div id="console-log">Initializing pipeline...</div>
      <div style="display:flex; justify-content:flex-end;">
        <button class="btn btn-secondary" onclick="closeModal('run-modal')">Close</button>
      </div>
    </div>
  </div>

  <!-- CSV Viewer Modal -->
  <div class="modal-overlay" id="csv-modal">
    <div class="modal-content modal-content-lg">
      <div class="modal-header">
        <div>
          <h3 id="csv-modal-title">📄 output.csv Viewer & Inspector</h3>
          <p style="font-size:0.8rem; color:var(--text-muted); margin-top:2px;" id="csv-modal-subtitle">518 Rows &bull; Formatted according to HackerRank schema</p>
        </div>
        <button class="close-modal" onclick="closeModal('csv-modal')">&times;</button>
      </div>
      
      <!-- Modal Toolbar -->
      <div style="display:flex; justify-content:space-between; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <div class="search-box" style="max-width:320px;">
          <span>🔍</span>
          <input type="text" id="csv-search-input" placeholder="Filter cases in table..." oninput="filterCsvTable()">
        </div>
        <div style="display:flex; gap:0.5rem;">
          <button class="btn btn-secondary btn-sm" onclick="copyRawCsv()">📋 Copy Entire CSV</button>
          <button class="btn btn-emerald btn-sm" onclick="downloadOutputCsv(false)">📥 Download output.csv</button>
          <button class="btn btn-secondary btn-sm" onclick="downloadOutputCsv(true)">📊 Download Excel CSV</button>
        </div>
      </div>

      <!-- CSV Table -->
      <div class="csv-table-wrapper">
        <table class="csv-table">
          <thead>
            <tr>
              <th style="width: 130px;">case_id</th>
              <th style="width: 140px;">deletion_status</th>
              <th>steps_json (Remediation & Verification Plan)</th>
            </tr>
          </thead>
          <tbody id="csv-table-body">
            <!-- Rows populated dynamically -->
          </tbody>
        </table>
      </div>

      <div style="display:flex; justify-content:space-between; align-items:center;">
        <span style="font-size:0.75rem; color:var(--text-muted);" id="csv-row-count-label">Loaded rows</span>
        <button class="btn btn-secondary" onclick="closeModal('csv-modal')">Close</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast" id="toast-msg">
    <span>✅</span>
    <span id="toast-text">Action completed</span>
  </div>

  <script>
    const API_BASE = (window.location.protocol === 'file:' || !window.location.port) ? 'http://localhost:5158' : '';
    let currentDataset = 'full';
    let currentFilter = 'ALL';
    let allCases = [];
    let activeCaseId = null;
    let rawCsvData = "";

    function showToast(text) {
      const toast = document.getElementById('toast-msg');
      document.getElementById('toast-text').textContent = text;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 3000);
    }

    async function loadStats() {
      try {
        const res = await fetch(`${API_BASE}/api/stats?dataset=${currentDataset}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        document.getElementById('metric-total').textContent = data.total;
        document.getElementById('metric-total-sub').textContent = currentDataset === 'full' ? 'Official evaluation requests' : 'Public sample cases';
        document.getElementById('metric-complete').textContent = data.complete;
        document.getElementById('metric-incomplete').textContent = data.incomplete;
        document.getElementById('metric-na').textContent = data.not_applicable;
      } catch (err) {
        console.warn('Could not load stats from server:', err);
      }
    }

    async function loadCases() {
      try {
        const res = await fetch(`${API_BASE}/api/cases?dataset=${currentDataset}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        allCases = await res.json();
        renderCases();
      } catch (err) {
        console.error('Failed to load cases:', err);
        showToast('⚠️ Could not connect to backend server. Make sure port 5158 is active.');
      }
    }

    function renderCases() {
      const q = document.getElementById('search-input').value.trim().toLowerCase();
      const container = document.getElementById('cases-container');
      container.innerHTML = '';

      const filtered = allCases.filter(c => {
        const matchesFilter = currentFilter === 'ALL' || c.deletion_status === currentFilter;
        const matchesSearch = !q || c.case_id.toLowerCase().includes(q) || (c.email && c.email.toLowerCase().includes(q));
        return matchesFilter && matchesSearch;
      });

      document.getElementById('case-count-label').textContent = `Showing ${filtered.length} of ${allCases.length} cases`;

      filtered.forEach(c => {
        const div = document.createElement('div');
        div.className = `case-item ${c.case_id === activeCaseId ? 'active' : ''}`;
        div.onclick = () => selectCase(c.case_id);
        div.innerHTML = `
          <div class="case-item-top">
            <span class="case-id">${c.case_id}</span>
            <span class="badge-status ${c.deletion_status}">${c.deletion_status}</span>
          </div>
          <div class="case-email">${c.email || 'No email'} &bull; ${c.step_count} steps</div>
        `;
        container.appendChild(div);
      });

      if (!activeCaseId && filtered.length > 0) {
        selectCase(filtered[0].case_id);
      }
    }

    async function selectCase(caseId) {
      activeCaseId = caseId;
      document.querySelectorAll('.case-item').forEach(el => {
        el.classList.toggle('active', el.querySelector('.case-id')?.textContent === caseId);
      });

      try {
        const res = await fetch(`${API_BASE}/api/case/${caseId}?dataset=${currentDataset}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const c = await res.json();
        displayCase(c);
      } catch (err) {
        console.error('Failed to load case detail:', err);
      }
    }

    let currentCaseObject = null;

    function displayCase(c) {
      currentCaseObject = c;
      document.getElementById('inspector-body').style.display = 'flex';
      document.getElementById('btn-export-case').style.display = 'inline-flex';
      document.getElementById('ins-case-id').textContent = c.case_id;
      document.getElementById('ins-case-subtitle').textContent = `Request audited at cutoff: ${c.audit_at || 'unknown'}`;
      
      const badge = document.getElementById('ins-status-badge');
      badge.textContent = c.deletion_status;
      badge.className = `badge-status ${c.deletion_status}`;

      document.getElementById('ins-email').textContent = c.email || '-';
      document.getElementById('ins-req-at').textContent = c.requested_at || '-';
      document.getElementById('ins-rep-status').textContent = c.reported_status || '-';
      document.getElementById('ins-audit-at').textContent = c.audit_at || '-';
      document.getElementById('ins-req-text').textContent = c.request_text || '(No request text provided)';

      // Identity
      document.getElementById('ins-user-id').textContent = c.identity?.user_id || 'unresolved';
      document.getElementById('ins-user-name').textContent = c.identity?.name || 'none';
      document.getElementById('ins-user-phone').textContent = c.identity?.phone || 'none';
      document.getElementById('ins-user-hash').textContent = c.identity?.email_hash || 'none';

      // Steps
      const stepsContainer = document.getElementById('ins-steps-container');
      stepsContainer.innerHTML = '';
      document.getElementById('ins-step-count').textContent = c.steps ? c.steps.length : 0;

      if (!c.steps || c.steps.length === 0) {
        stepsContainer.innerHTML = '<div style="color:var(--text-sub); font-size:0.8rem; padding:0.5rem 0;">No remediation or verification steps required (NOT_APPLICABLE or empty).</div>';
      } else {
        c.steps.forEach(s => {
          const card = document.createElement('div');
          card.className = 'step-card';
          card.innerHTML = `
            <div class="step-num">${s.step_no}</div>
            <div class="step-main">
              <div class="step-op">${s.operation} &rarr; <span style="color:var(--accent-cyan);">${s.resource_id}</span></div>
              <div class="step-details">
                <span>System: <b>${s.system_id}</b></span>
                <span>Target State: <b>${s.state}</b></span>
                ${s.evidence_id ? `<span>Evidence: <b style="color:var(--accent-amber);">${s.evidence_id}</b></span>` : ''}
              </div>
            </div>
            <span class="step-badge-phase phase-${s.phase}">${s.phase}</span>
          `;
          stepsContainer.appendChild(card);
        });
      }

      document.getElementById('ins-json-code').textContent = JSON.stringify(c.steps || [], null, 2);
    }

    function setFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === filter);
      });
      renderCases();
    }

    function handleSearch() {
      const q = document.getElementById('search-input').value.trim();
      document.getElementById('search-clear').style.display = q ? 'block' : 'none';
      renderCases();
    }

    function clearSearch() {
      document.getElementById('search-input').value = '';
      document.getElementById('search-clear').style.display = 'none';
      renderCases();
    }

    function switchDataset(ds) {
      currentDataset = ds;
      document.getElementById('btn-ds-full').classList.toggle('active', ds === 'full');
      document.getElementById('btn-ds-sample').classList.toggle('active', ds === 'sample');
      activeCaseId = null;
      loadStats();
      loadCases();
      showToast(`Switched to ${ds === 'full' ? 'Full Evaluation (518)' : 'Sample Set (32)'}`);
    }

    async function runAudit(type) {
      document.getElementById('modal-title').textContent = type === 'full' ? '🚀 Running Full 518-Case Audit' : '⚡ Running Sample 32-Case Audit';
      document.getElementById('console-log').textContent = `Starting ${type} audit pipeline on server...\nExecuting deterministic Python engine...\n`;
      document.getElementById('run-modal').classList.add('open');

      try {
        const res = await fetch(`${API_BASE}/api/run`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type })
        });
        const data = await res.json();
        document.getElementById('console-log').textContent += `\n${data.log}\n\n✅ Finished in ${data.duration_sec}s with 0 contract errors!\nRefreshed output.csv, evaluation_report.md, and code.zip.`;
        if (type === 'sample') {
          switchDataset('sample');
        } else {
          switchDataset('full');
        }
        showToast('Audit pipeline completed successfully!');
      } catch (err) {
        document.getElementById('console-log').textContent += `\n❌ Error executing audit: ${err.message}`;
        showToast('Error executing audit pipeline.');
      }
    }

    function closeModal(id) {
      document.getElementById(id).classList.remove('open');
    }

    // Direct Download Helper
    async function downloadOutputCsv(forExcel = false) {
      showToast(forExcel ? 'Generating Excel-friendly CSV with UTF-8 BOM...' : 'Downloading output.csv...');
      try {
        const url = `${API_BASE}/api/download/${forExcel ? 'output_excel.csv' : 'output.csv'}?dataset=${currentDataset}${forExcel ? '&excel=1' : ''}`;
        const res = await fetch(url);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const blob = await res.blob();
        
        // Trigger browser download via Blob URL
        const blobUrl = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = forExcel ? 'output_excel.csv' : 'output.csv';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(blobUrl);
        showToast(`Downloaded ${forExcel ? 'output_excel.csv' : 'output.csv'} successfully!`);
      } catch (err) {
        console.error('Download error:', err);
        // Fallback: direct window open
        window.location.href = `${API_BASE}/api/download/output.csv`;
      }
    }

    function downloadBundle(path, filename) {
      showToast(`Downloading ${filename}...`);
      const a = document.createElement('a');
      a.href = `${API_BASE}${path}`;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }

    // CSV Viewer Modal
    let fullCsvRows = [];

    async function openCsvModal() {
      document.getElementById('csv-modal').classList.add('open');
      document.getElementById('csv-table-body').innerHTML = '<tr><td colspan="3" style="text-align:center; padding:2rem; color:var(--text-muted);">Loading output.csv data...</td></tr>';
      
      try {
        const res = await fetch(`${API_BASE}/api/csv_data?dataset=${currentDataset}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        rawCsvData = data.raw_text;
        
        // Parse CSV text into rows
        parseAndRenderCsv(rawCsvData);
      } catch (err) {
        document.getElementById('csv-table-body').innerHTML = `<tr><td colspan="3" style="color:var(--accent-rose); padding:2rem;">Could not load CSV: ${err.message}</td></tr>`;
      }
    }

    function parseAndRenderCsv(text) {
      const lines = text.trim().split(/\r?\n/);
      fullCsvRows = [];
      
      // Skip header line 0
      for (let i = 1; i < lines.length; i++) {
        const line = lines[i];
        if (!line) continue;
        const firstComma = line.indexOf(',');
        const secondComma = line.indexOf(',', firstComma + 1);
        if (firstComma === -1 || secondComma === -1) continue;
        
        const caseId = line.substring(0, firstComma);
        const status = line.substring(firstComma + 1, secondComma);
        let stepsJson = line.substring(secondComma + 1);
        if (stepsJson.startsWith('"') && stepsJson.endsWith('"')) {
          stepsJson = stepsJson.slice(1, -1).replace(/""/g, '"');
        }
        fullCsvRows.push({ caseId, status, stepsJson });
      }

      document.getElementById('csv-modal-subtitle').textContent = `${fullCsvRows.length} Rows &bull; File: ${currentDataset === 'full' ? 'output.csv (Full 518)' : 'sample_pred.csv (Sample 32)'}`;
      filterCsvTable();
    }

    function filterCsvTable() {
      const q = document.getElementById('csv-search-input').value.trim().toLowerCase();
      const tbody = document.getElementById('csv-table-body');
      tbody.innerHTML = '';

      const matched = fullCsvRows.filter(r => !q || r.caseId.toLowerCase().includes(q) || r.status.toLowerCase().includes(q) || r.stepsJson.toLowerCase().includes(q));

      document.getElementById('csv-row-count-label').textContent = `Showing ${matched.length} of ${fullCsvRows.length} total rows`;

      matched.slice(0, 150).forEach(r => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td style="font-weight:700; color:#fff;">${r.caseId}</td>
          <td><span class="badge-status ${r.status}">${r.status}</span></td>
          <td style="color:#a7f3d0; word-break:break-all;">${escapeHtml(r.stepsJson)}</td>
        `;
        tbody.appendChild(tr);
      });

      if (matched.length > 150) {
        const tr = document.createElement('tr');
        tr.innerHTML = `<td colspan="3" style="text-align:center; padding:1rem; color:var(--text-muted); font-style:italic;">Displaying first 150 matching rows for high performance. (Use search box above to narrow down).</td>`;
        tbody.appendChild(tr);
      }
    }

    function escapeHtml(str) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    async function copyRawCsv() {
      if (!rawCsvData) return;
      try {
        await navigator.clipboard.writeText(rawCsvData);
        showToast('Entire CSV copied to clipboard!');
      } catch (err) {
        showToast('Clipboard access denied.');
      }
    }

    async function copyText(elemId) {
      const text = document.getElementById(elemId).textContent;
      try {
        await navigator.clipboard.writeText(text);
        showToast('Copied to clipboard!');
      } catch (err) {
        showToast('Clipboard access denied.');
      }
    }

    function exportCurrentCase() {
      if (!currentCaseObject) return;
      const jsonStr = JSON.stringify(currentCaseObject, null, 2);
      const blob = new Blob([jsonStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${currentCaseObject.case_id}_audit.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast(`Exported ${currentCaseObject.case_id}_audit.json`);
    }

    // Initial load
    window.onload = () => {
      loadStats();
      loadCases();
    };
  </script>
</body>
</html>
