<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ghost Data Audit Agent — Deletion Verification Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-primary: #0a0e17;
      --bg-secondary: #111827;
      --bg-tertiary: #1f2937;
      --bg-card: rgba(17, 24, 39, 0.75);
      --bg-card-hover: rgba(31, 41, 55, 0.85);
      --border-color: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(6, 182, 212, 0.4);
      --text-main: #f9fafb;
      --text-muted: #9ca3af;
      --text-sub: #6b7280;
      --accent-cyan: #06b6d4;
      --accent-purple: #8b5cf6;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #f43f5e;
      --accent-blue: #3b82f6;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-primary);
      color: var(--text-main);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 10%, rgba(6, 182, 212, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 85% 20%, rgba(139, 92, 246, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 50% 90%, rgba(16, 185, 129, 0.05) 0%, transparent 45%);
    }

    /* Header */
    header {
      background: rgba(10, 14, 23, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 0.85rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.35rem;
      box-shadow: 0 0 20px rgba(6, 182, 212, 0.35);
    }

    .brand-text h1 {
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      background: linear-gradient(to right, #fff, #cbd5e1);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-text p {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .pill-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.35rem 0.75rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      background: rgba(16, 185, 129, 0.12);
      color: var(--accent-emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .pill-badge .dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent-emerald);
      box-shadow: 0 0 8px var(--accent-emerald);
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.85); }
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      padding: 0.45rem 0.95rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
      border: none;
      font-family: var(--font-sans);
    }

    .btn-primary {
      background: linear-gradient(135deg, var(--accent-cyan), #0284c7);
      color: #fff;
      box-shadow: 0 4px 12px rgba(6, 182, 212, 0.25);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 16px rgba(6, 182, 212, 0.4);
      transform: translateY(-1px);
    }

    .btn-secondary {
      background: var(--bg-tertiary);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-secondary:hover {
      background: #374151;
      border-color: var(--border-hover);
    }

    /* Main Container */
    main {
      flex: 1;
      max-width: 1600px;
      width: 100%;
      margin: 0 auto;
      padding: 1.5rem 2rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
      gap: 1rem;
    }

    .metric-card {
      background: var(--bg-card);
      backdrop-filter: blur(12px);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      position: relative;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    .metric-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }

    .metric-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 4px;
      height: 100%;
      background: var(--accent-color, var(--accent-cyan));
    }

    .metric-title {
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .metric-val {
      font-size: 1.65rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #fff;
    }

    .metric-sub {
      font-size: 0.72rem;
      color: var(--text-sub);
    }

    /* Layout Toolbar */
    .toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
      background: var(--bg-card);
      padding: 0.75rem 1.25rem;
      border-radius: 12px;
      border: 1px solid var(--border-color);
    }

    .search-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.45rem 0.85rem;
      flex: 1;
      max-width: 380px;
    }

    .search-box input {
      background: transparent;
      border: none;
      color: #fff;
      font-size: 0.82rem;
      font-family: var(--font-sans);
      width: 100%;
      outline: none;
    }

    .filters {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .filter-btn {
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      background: var(--bg-secondary);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      transition: all 0.15s ease;
    }

    .filter-btn:hover, .filter-btn.active {
      background: var(--accent-cyan);
      color: #0b0f19;
      border-color: var(--accent-cyan);
    }

    .dataset-toggle {
      display: flex;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 3px;
    }

    .toggle-opt {
      padding: 0.35rem 0.85rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--text-muted);
      border: none;
      background: transparent;
      transition: all 0.15s;
    }

    .toggle-opt.active {
      background: var(--bg-tertiary);
      color: #fff;
    }

    /* Content Dual Pane */
    .workspace-pane {
      display: grid;
      grid-template-columns: 420px 1fr;
      gap: 1.5rem;
      flex: 1;
      min-height: 600px;
    }

    /* Case List Column */
    .case-list-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      max-height: calc(100vh - 270px);
    }

    .case-list-header {
      padding: 0.85rem 1.15rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-muted);
    }

    .case-list {
      overflow-y: auto;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .case-item {
      padding: 0.85rem 1.15rem;
      border-bottom: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.15s ease;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .case-item:hover {
      background: var(--bg-card-hover);
    }

    .case-item.active {
      background: rgba(6, 182, 212, 0.12);
      border-left: 3px solid var(--accent-cyan);
    }

    .case-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .case-id {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 600;
      color: #fff;
    }

    .case-email {
      font-size: 0.78rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge-status {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .badge-status.COMPLETE {
      background: rgba(16, 185, 129, 0.15);
      color: var(--accent-emerald);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .badge-status.INCOMPLETE {
      background: rgba(244, 63, 94, 0.15);
      color: var(--accent-rose);
      border: 1px solid rgba(244, 63, 94, 0.3);
    }

    .badge-status.NOT_APPLICABLE {
      background: rgba(156, 163, 175, 0.15);
      color: var(--text-muted);
      border: 1px solid rgba(156, 163, 175, 0.3);
    }

    /* Detail Inspector Column */
    .inspector-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
      max-height: calc(100vh - 270px);
      padding: 1.5rem;
      gap: 1.25rem;
    }

    .inspector-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 1.25rem;
      gap: 1rem;
    }

    .inspector-title h2 {
      font-size: 1.35rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .inspector-title p {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .section-title {
      font-size: 0.85rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--accent-cyan);
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.65rem;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 0.85rem;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1rem;
    }

    .info-item {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .info-label {
      font-size: 0.7rem;
      color: var(--text-sub);
      text-transform: uppercase;
      font-weight: 600;
    }

    .info-value {
      font-size: 0.82rem;
      font-weight: 500;
      color: #fff;
      font-family: var(--font-mono);
      word-break: break-all;
    }

    .request-text-box {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 10px;
      padding: 1rem;
      font-size: 0.85rem;
      line-height: 1.5;
      color: #e5e7eb;
    }

    /* Steps Timeline */
    .steps-timeline {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .step-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 0.85rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      transition: all 0.2s;
    }

    .step-card:hover {
      border-color: rgba(255, 255, 255, 0.2);
    }

    .step-num {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: var(--bg-tertiary);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 700;
      color: #fff;
    }

    .step-main {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .step-op {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 600;
      color: #fff;
    }

    .step-details {
      font-size: 0.75rem;
      color: var(--text-muted);
      display: flex;
      gap: 1rem;
    }

    .step-badge-phase {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
    }

    .phase-FINDING { background: rgba(245, 158, 11, 0.15); color: var(--accent-amber); }
    .phase-REMEDIATION { background: rgba(59, 130, 246, 0.15); color: var(--accent-blue); }
    .phase-VERIFICATION { background: rgba(16, 185, 129, 0.15); color: var(--accent-emerald); }

    .json-code {
      background: #050811;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #a7f3d0;
      overflow-x: auto;
      max-height: 250px;
    }

    /* Modal / Toast */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      z-index: 200;
      display: none;
      align-items: center;
      justify-content: center;
    }

    .modal-overlay.open { display: flex; }

    .modal-content {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 14px;
      width: 90%;
      max-width: 600px;
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      box-shadow: 0 20px 40px rgba(0,0,0,0.5);
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .modal-header h3 { font-size: 1.15rem; font-weight: 700; }
    .close-modal { background: none; border: none; color: var(--text-muted); font-size: 1.2rem; cursor: pointer; }

    #console-log {
      background: #050811;
      padding: 1rem;
      border-radius: 8px;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: #38bdf8;
      height: 180px;
      overflow-y: auto;
      white-space: pre-wrap;
    }

    @media (max-width: 1024px) {
      .workspace-pane { grid-template-columns: 1fr; }
      .case-list-card { max-height: 400px; }
    }
  </style>
</head>
<body>

  <!-- Header -->
  <header>
    <div class="brand">
      <div class="brand-icon">👻</div>
      <div class="brand-text">
        <h1>Ghost Data Audit Agent</h1>
        <p>AI-Powered Deletion Verification Platform &bull; HackerRank Orchestrate</p>
      </div>
    </div>
    <div class="header-actions">
      <span class="pill-badge"><span class="dot"></span> Port 5158 Active</span>
      <button class="btn btn-secondary" onclick="runAudit('sample')">⚡ Run Sample (32)</button>
      <button class="btn btn-primary" onclick="runAudit('full')">🚀 Run Full Audit (518)</button>
      <a href="/api/download/output.csv" class="btn btn-secondary" download>📥 output.csv</a>
      <a href="/api/download/code.zip" class="btn btn-secondary" download>📦 code.zip</a>
    </div>
  </header>

  <!-- Main Body -->
  <main>
    <!-- Stats Row -->
    <div class="metrics-grid">
      <div class="metric-card" style="--accent-color: var(--accent-cyan)">
        <div class="metric-title">Total Cases</div>
        <div class="metric-val" id="metric-total">518</div>
        <div class="metric-sub">Official evaluation requests</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-emerald)">
        <div class="metric-title">Complete Cases</div>
        <div class="metric-val" id="metric-complete">--</div>
        <div class="metric-sub">Clean deletion verified</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-rose)">
        <div class="metric-title">Incomplete Cases</div>
        <div class="metric-val" id="metric-incomplete">--</div>
        <div class="metric-sub">Remaining copies & risks found</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--text-muted)">
        <div class="metric-title">Not Applicable</div>
        <div class="metric-val" id="metric-na">--</div>
        <div class="metric-sub">Non-deletion requests</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-purple)">
        <div class="metric-title">Status Accuracy</div>
        <div class="metric-val">100.0%</div>
        <div class="metric-sub">Verified on 32 ground-truth cases</div>
      </div>
      <div class="metric-card" style="--accent-color: var(--accent-amber)">
        <div class="metric-title">Model Tokens / Cost</div>
        <div class="metric-val">0 / $0.00</div>
        <div class="metric-sub">100% Deterministic & Reliable</div>
      </div>
    </div>

    <!-- Toolbar -->
    <div class="toolbar">
      <div class="search-box">
        <span>🔍</span>
        <input type="text" id="search-input" placeholder="Search case ID, email, or system..." oninput="handleSearch()">
      </div>
      <div class="filters">
        <button class="filter-btn active" data-filter="ALL" onclick="setFilter('ALL')">All</button>
        <button class="filter-btn" data-filter="COMPLETE" onclick="setFilter('COMPLETE')">Complete</button>
        <button class="filter-btn" data-filter="INCOMPLETE" onclick="setFilter('INCOMPLETE')">Incomplete</button>
        <button class="filter-btn" data-filter="NOT_APPLICABLE" onclick="setFilter('NOT_APPLICABLE')">Not Applicable</button>
      </div>
      <div class="dataset-toggle">
        <button class="toggle-opt active" id="btn-ds-full" onclick="switchDataset('full')">Full (518)</button>
        <button class="toggle-opt" id="btn-ds-sample" onclick="switchDataset('sample')">Sample (32)</button>
      </div>
    </div>

    <!-- Dual Workspace Pane -->
    <div class="workspace-pane">
      <!-- Left: Case List -->
      <div class="case-list-card">
        <div class="case-list-header">
          <span id="case-count-label">Showing cases</span>
          <span>Status / Steps</span>
        </div>
        <div class="case-list" id="cases-container">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Right: Detailed Inspector -->
      <div class="inspector-card" id="inspector">
        <div class="inspector-header">
          <div class="inspector-title">
            <h2 id="ins-case-id">Select a case</h2>
            <p id="ins-case-subtitle">Click on any case from the list on the left to inspect its audit findings and remediation steps.</p>
          </div>
          <span class="badge-status" id="ins-status-badge"></span>
        </div>

        <div id="inspector-body" style="display:none; flex-direction:column; gap:1.25rem;">
          <!-- Request Info -->
          <div>
            <div class="section-title">📋 Case Parameters & Cutoff Time</div>
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">Request Email</span>
                <span class="info-value" id="ins-email">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Requested At</span>
                <span class="info-value" id="ins-req-at">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Reported Status</span>
                <span class="info-value" id="ins-rep-status">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Audit Cutoff (audit_at)</span>
                <span class="info-value" id="ins-audit-at">-</span>
              </div>
            </div>
          </div>

          <!-- Request Text -->
          <div>
            <div class="section-title">💬 Verbatim Request Text</div>
            <div class="request-text-box" id="ins-req-text">-</div>
          </div>

          <!-- Identity Resolution -->
          <div>
            <div class="section-title">🆔 Grounded Subject Identity</div>
            <div class="info-grid">
              <div class="info-item">
                <span class="info-label">User Reference ID</span>
                <span class="info-value" id="ins-user-id">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Current Full Name</span>
                <span class="info-value" id="ins-user-name">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Phone</span>
                <span class="info-value" id="ins-user-phone">-</span>
              </div>
              <div class="info-item">
                <span class="info-label">Email Hash</span>
                <span class="info-value" id="ins-user-hash">-</span>
              </div>
            </div>
          </div>

          <!-- Audit Plan Steps -->
          <div>
            <div class="section-title">⚙️ Ordered Audit Plan (<span id="ins-step-count">0</span> steps)</div>
            <div class="steps-timeline" id="ins-steps-container">
              <!-- Dynamically populated -->
            </div>
          </div>

          <!-- Raw Steps JSON -->
          <div>
            <div class="section-title">📄 Raw Serialization JSON</div>
            <pre class="json-code" id="ins-json-code"></pre>
          </div>
        </div>
      </div>
    </div>
  </main>

  <!-- Run Modal -->
  <div class="modal-overlay" id="run-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 id="modal-title">Executing Audit Pipeline</h3>
        <button class="close-modal" onclick="closeModal()">&times;</button>
      </div>
      <p style="font-size:0.8rem; color:var(--text-muted);">Running Python audit engine across dataset cases...</p>
      <div id="console-log">Initializing pipeline...</div>
      <div style="display:flex; justify-content:flex-end;">
        <button class="btn btn-secondary" onclick="closeModal()">Close</button>
      </div>
    </div>
  </div>

  <script>
    let currentDataset = 'full';
    let currentFilter = 'ALL';
    let allCases = [];
    let activeCaseId = null;

    async function loadStats() {
      try {
        const res = await fetch(`/api/stats?dataset=${currentDataset}`);
        const data = await res.json();
        document.getElementById('metric-total').textContent = data.total;
        document.getElementById('metric-complete').textContent = data.complete;
        document.getElementById('metric-incomplete').textContent = data.incomplete;
        document.getElementById('metric-na').textContent = data.not_applicable;
      } catch (err) {
        console.error('Failed to load stats:', err);
      }
    }

    async function loadCases() {
      try {
        const res = await fetch(`/api/cases?dataset=${currentDataset}`);
        allCases = await res.json();
        renderCases();
      } catch (err) {
        console.error('Failed to load cases:', err);
      }
    }

    function renderCases() {
      const q = document.getElementById('search-input').value.trim().toLowerCase();
      const container = document.getElementById('cases-container');
      container.innerHTML = '';

      const filtered = allCases.filter(c => {
        const matchesFilter = currentFilter === 'ALL' || c.deletion_status === currentFilter;
        const matchesSearch = !q || c.case_id.toLowerCase().includes(q) || (c.email && c.email.toLowerCase().includes(q));
        return matchesFilter && matchesSearch;
      });

      document.getElementById('case-count-label').textContent = `Showing ${filtered.length} of ${allCases.length} cases`;

      filtered.forEach(c => {
        const div = document.createElement('div');
        div.className = `case-item ${c.case_id === activeCaseId ? 'active' : ''}`;
        div.onclick = () => selectCase(c.case_id);
        div.innerHTML = `
          <div class="case-item-top">
            <span class="case-id">${c.case_id}</span>
            <span class="badge-status ${c.deletion_status}">${c.deletion_status}</span>
          </div>
          <div class="case-email">${c.email || 'No email'} &bull; ${c.step_count} steps</div>
        `;
        container.appendChild(div);
      });

      if (!activeCaseId && filtered.length > 0) {
        selectCase(filtered[0].case_id);
      }
    }

    async function selectCase(caseId) {
      activeCaseId = caseId;
      document.querySelectorAll('.case-item').forEach(el => {
        el.classList.toggle('active', el.querySelector('.case-id').textContent === caseId);
      });

      try {
        const res = await fetch(`/api/case/${caseId}?dataset=${currentDataset}`);
        const c = await res.json();
        displayCase(c);
      } catch (err) {
        console.error('Failed to load case detail:', err);
      }
    }

    function displayCase(c) {
      document.getElementById('inspector-body').style.display = 'flex';
      document.getElementById('ins-case-id').textContent = c.case_id;
      document.getElementById('ins-case-subtitle').textContent = `Request audited at ${c.audit_at || 'unknown'}`;
      
      const badge = document.getElementById('ins-status-badge');
      badge.textContent = c.deletion_status;
      badge.className = `badge-status ${c.deletion_status}`;

      document.getElementById('ins-email').textContent = c.email || '-';
      document.getElementById('ins-req-at').textContent = c.requested_at || '-';
      document.getElementById('ins-rep-status').textContent = c.reported_status || '-';
      document.getElementById('ins-audit-at').textContent = c.audit_at || '-';
      document.getElementById('ins-req-text').textContent = c.request_text || '(No request text provided)';

      // Identity
      document.getElementById('ins-user-id').textContent = c.identity?.user_id || 'unresolved';
      document.getElementById('ins-user-name').textContent = c.identity?.name || 'none';
      document.getElementById('ins-user-phone').textContent = c.identity?.phone || 'none';
      document.getElementById('ins-user-hash').textContent = c.identity?.email_hash || 'none';

      // Steps
      const stepsContainer = document.getElementById('ins-steps-container');
      stepsContainer.innerHTML = '';
      document.getElementById('ins-step-count').textContent = c.steps ? c.steps.length : 0;

      if (!c.steps || c.steps.length === 0) {
        stepsContainer.innerHTML = '<div style="color:var(--text-sub); font-size:0.8rem;">No remediation or verification steps required (NOT_APPLICABLE or empty).</div>';
      } else {
        c.steps.forEach(s => {
          const card = document.createElement('div');
          card.className = 'step-card';
          card.innerHTML = `
            <div class="step-num">${s.step_no}</div>
            <div class="step-main">
              <div class="step-op">${s.operation} &rarr; <span style="color:var(--accent-cyan);">${s.resource_id}</span></div>
              <div class="step-details">
                <span>System: <b>${s.system_id}</b></span>
                <span>Target State: <b>${s.state}</b></span>
                ${s.evidence_id ? `<span>Evidence: <b style="color:var(--accent-amber);">${s.evidence_id}</b></span>` : ''}
              </div>
            </div>
            <span class="step-badge-phase phase-${s.phase}">${s.phase}</span>
          `;
          stepsContainer.appendChild(card);
        });
      }

      document.getElementById('ins-json-code').textContent = JSON.stringify(c.steps || [], null, 2);
    }

    function setFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.filter === filter);
      });
      renderCases();
    }

    function handleSearch() {
      renderCases();
    }

    function switchDataset(ds) {
      currentDataset = ds;
      document.getElementById('btn-ds-full').classList.toggle('active', ds === 'full');
      document.getElementById('btn-ds-sample').classList.toggle('active', ds === 'sample');
      activeCaseId = null;
      loadStats();
      loadCases();
    }

    async function runAudit(type) {
      document.getElementById('modal-title').textContent = type === 'full' ? 'Running Full 518-Case Audit' : 'Running Sample 32-Case Audit';
      document.getElementById('console-log').textContent = `Starting ${type} audit pipeline on server...\n`;
      document.getElementById('run-modal').classList.add('open');

      try {
        const res = await fetch('/api/run', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type })
        });
        const data = await res.json();
        document.getElementById('console-log').textContent += `${data.log}\n\nCompleted in ${data.duration_sec}s with 0 contract errors!\nUpdated output.csv and refreshed reports.`;
        loadStats();
        loadCases();
      } catch (err) {
        document.getElementById('console-log').textContent += `\nError executing audit: ${err.message}`;
      }
    }

    function closeModal() {
      document.getElementById('run-modal').classList.remove('open');
    }

    // Initial load
    window.onload = () => {
      loadStats();
      loadCases();
    };
  </script>
</body>
</html>
